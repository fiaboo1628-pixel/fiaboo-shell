#!/usr/bin/env bash
# Run fiaboo-shell for the whole Hyprland session (started from hypr/custom.lua).
#  - fiaboo-shell owns org.freedesktop.Notifications; swaync (if D-Bus-activated meanwhile) is stopped
#  - restarts fiaboo-shell if it crashes or its binary was replaced (upgrade: install, then pkill -9);
#    `pkill fiaboo-shell` (SIGTERM) stops it for good
#  - if it dies within 30 s of starting, swaync takes over notifications and it is retried every 30 s
BIN=${FIABOO_SHELL_BIN:-$HOME/.local/bin/fiaboo-shell}
LOG=$HOME/.cache/fiaboo-shell.log

while true; do
    pkill -x swaync   # may have been D-Bus-activated while fiaboo-shell was down; the shell takes the name over
    start=$(date +%s); stamp=$(stat -c %Y "$BIN" 2>/dev/null)
    "$BIN" >>"$LOG" 2>&1
    rc=$?
    if [ $rc -eq 143 ] || [ $rc -eq 130 ]; then exit 0; fi          # stopped on purpose
    if [ "$(stat -c %Y "$BIN" 2>/dev/null)" != "$stamp" ]; then sleep 1; continue; fi  # binary upgraded: just restart
    if [ $(( $(date +%s) - start )) -lt 30 ]; then
        # failing at start: keep notifications working meanwhile, then try again
        pgrep -x swaync >/dev/null || { setsid swaync >/dev/null 2>&1 & sleep 1; }
        notify-send "fiaboo-shell" "Failed to start, retrying in 30 s (log: $LOG)" 2>/dev/null
        sleep 30
        continue
    fi
    sleep 2                                                           # crashed after running a while: restart
done
