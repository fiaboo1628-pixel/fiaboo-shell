#!/bin/sh
# Set the wallpaper (colours stay fixed).
#   fiaboo-wallpaper <image> | --random | --restore
set -u
dir="$HOME/Pictures/wallpapers"
cache_dir="$HOME/.cache/fiaboo-shell/wallpaper"
cache="$cache_dir/current"

# one change at a time: two quick clicks would mix matugen colours and half-written lock-screen images
mkdir -p "$cache_dir"
exec 9>"$cache_dir/.lock"
flock -w 60 9 || exit 1 # bounded: a long-lived child that inherited fd 9 must not block every later change

restore=
case "${1:-}" in
    --random) img=$(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n1) ;;
    --restore) img=$(cat "$cache" 2>/dev/null); restore=1 ;;
    *) img=${1:-} ;;
esac
[ -f "$img" ] || img=$(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort | head -1)
[ -f "$img" ] || { echo "fiaboo-wallpaper: no image in $dir" >&2; exit 1; }
img=$(realpath -- "$img") # --restore at login runs from another directory

for _ in $(seq 30); do awww query >/dev/null 2>&1 && break; sleep 1; done
if [ -n "$restore" ]; then
    awww img "$img" --transition-type none
    exit 0 # colours and lock-screen images are still on disk from the last change
fi
# not shown (awww never came up): don't recolor or remember an image nobody sees
awww img "$img" --transition-type simple || exit 1
echo "$img" > "$cache"

matugen color hex "#89b4fa" -m dark # fixed Mocha-blue scheme for GTK/Qt/borders, not from the wallpaper (owner, 2026-10-17)

# hyprlock shows these
magick "$img" -resize 75% -blur 50x30 "$cache_dir/blurred.tmp.png" && mv "$cache_dir/blurred.tmp.png" "$cache_dir/blurred.png"
magick "$img" -gravity Center -extent 1:1 "$cache_dir/square.tmp.png" && mv "$cache_dir/square.tmp.png" "$cache_dir/square.png"
