#!/bin/sh
# Set the wallpaper and recolor the desktop from it (replaces ml4w-wallpaper).
#   fiaboo-wallpaper <image> | --random | --restore
# Reads the ML4W settings/cache files so the old scripts (fallback) stay in agreement.
set -u
cache_dir="$HOME/.cache/ml4w/hyprland-dotfiles"
cache="$cache_dir/current_wallpaper"
settings="$HOME/.config/ml4w/settings"
dir=$(sed "s|^\$HOME|$HOME|;s|^~|$HOME|" "$settings/wallpaper-folder" 2>/dev/null)
[ -d "$dir" ] || dir="$HOME/.config/ml4w/wallpapers"

restore=
case "${1:-}" in
    --random) img=$(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n1) ;;
    --restore) img=$(cat "$cache" 2>/dev/null); restore=1 ;;
    *) img=${1:-} ;;
esac
[ -f "$img" ] || img="$HOME/.config/ml4w/wallpapers/default.jpg"
[ -f "$img" ] || { echo "fiaboo-wallpaper: no image" >&2; exit 1; }

for _ in $(seq 30); do awww query >/dev/null 2>&1 && break; sleep 1; done
if [ -n "$restore" ]; then
    awww img "$img" --transition-type none
    exit 0 # colours and lock-screen images are still on disk from the last change
fi
awww img "$img" --transition-type "$(cat "$settings/wallpaper-transition-effect" 2>/dev/null || echo simple)"
mkdir -p "$cache_dir"
echo "$img" > "$cache"

mode=dark
grep -qE '^gtk-application-prefer-dark-theme=(0|false)' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null && mode=light
matugen image "$img" --source-color-index 0 -m "$mode"

# hyprlock (and wlogout) show these
blur=$(cat "$settings/blur.sh" 2>/dev/null || echo 50x30)
magick "$img" -resize 75% -blur "$blur" "$cache_dir/blurred_wallpaper.png"
magick "$img" -gravity Center -extent 1:1 "$cache_dir/square_wallpaper.png"
