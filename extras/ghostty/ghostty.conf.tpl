# Generated by `theme <name>` from themes/<name>/colors.toml -- do not edit by hand.
# Lives at ~/.local/share/fiaboo-theme/templates/ghostty.conf.tpl; `theme` renders it to
# ~/.config/ghostty/current-theme.conf and reloads Ghostty with SIGUSR2 (tested safe).
# ghostty/config includes this with config-file, which Ghostty loads after the main file, so
# nothing here may set `background`: the terminal's body stays the black set in ghostty/config.
# Colour roles follow kitty.conf.tpl
foreground = {{ foreground }}
selection-foreground = {{ background }}
selection-background = {{ light_foreground }}
cursor-color = {{ bright_foreground }}
cursor-text = {{ background }}
# the one split colour Ghostty has (1.1.0+): the divider line, the same for every split
split-divider-color = {{ muted }}
palette = 0={{ background }}
palette = 1={{ red }}
palette = 2={{ green }}
palette = 3={{ yellow }}
palette = 4={{ blue }}
palette = 5={{ magenta }}
palette = 6={{ cyan }}
palette = 7={{ foreground }}
palette = 8={{ muted }}
palette = 9={{ bright_red }}
palette = 10={{ bright_green }}
palette = 11={{ bright_yellow }}
palette = 12={{ bright_blue }}
palette = 13={{ bright_magenta }}
palette = 14={{ bright_cyan }}
palette = 15={{ bright_foreground }}
